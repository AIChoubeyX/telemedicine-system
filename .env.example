# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amrutam_telemedicine?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amrutam_telemedicine_test?schema=public

# Authentication & Security
JWT_SECRET=replace-with-a-very-long-secret-key-min-32-characters
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace-with-another-secure-secret-key-min-32-characters
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS & Security
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Cache / Redis (Optional - leave empty for automatic in-memory fallback)
REDIS_URL=
